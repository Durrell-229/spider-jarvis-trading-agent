# ============================================================
# SPIDER JARVIS TRADING AGENT - Configuration
# ============================================================
# IMPORTANT: Copiez ce fichier vers .env et ne commitez JAMAIS .env
# ============================================================

APP_ENV=development
APP_NAME=Spider Jarvis Trading Agent
APP_VERSION=0.1.0

# TRADING MODE - PAPER UNIQUEMENT PAR DÉFAUT
# Pour activer le live (DANGEREUX):
#   TRADING_MODE=live
#   LIVE_TRADING_CONFIRMATION=I_UNDERSTAND_THE_RISK
TRADING_MODE=paper
LIVE_TRADING_CONFIRMATION=

# Base de données
DATABASE_URL=sqlite:///./spider_jarvis.db

# Fournisseur de données
DATA_PROVIDER=mock
EXCHANGE_NAME=none
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Limites de risque OBLIGATOIRES
MAX_TRADE_AMOUNT=25.0
MAX_DAILY_LOSS=50.0
MAX_OPEN_POSITIONS=3
MAX_DAILY_TRADES=10
DEFAULT_STOP_LOSS_PERCENT=2.0
DEFAULT_TAKE_PROFIT_PERCENT=4.0
MAX_POSITION_SIZE_PERCENT=10.0
COOLDOWN_AFTER_LOSSES_SECONDS=300
MAX_DATA_AGE_SECONDS=60

# JEV
JEV_PROVIDER=local
JEV_MODEL=rule_based

# Serveur
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logs
LOG_LEVEL=INFO
LOG_FILE=logs/spider_jarvis.log

# Sécurité
RATE_LIMIT_PER_MINUTE=60
ENABLE_AUTH=false
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# Scheduler
SCAN_INTERVAL_SECONDS=30
ENABLE_SCHEDULER=true
